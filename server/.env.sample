# ── LLM ──────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_LLM_MODEL=gemini-3.5-flash

# ── Razorpay (test-mode only — no real money) ─────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/paisaan

# ── LangGraph checkpointer (state persistence across requests) ────────────────
CHECKPOINT_DB_URL=postgresql://postgres:password@localhost:5432/paisaan

# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000
FRONTEND_URL=http://localhost:5280

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development

# ── LangSmith (Optional for testing/tracing) ──────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=paisaan_dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com